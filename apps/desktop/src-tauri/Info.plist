<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Servers on the local network, and device sync finding your other devices (Bonjour). -->
  <key>NSLocalNetworkUsageDescription</key>
  <string>Hostealo Terminal se conecta a los servidores de tu red local y busca tus otros dispositivos para sincronizar tus servidores, sin pasar por internet.</string>
  <key>NSBonjourServices</key>
  <array>
    <string>_hostealo-sync._tcp</string>
  </array>
  <!-- Device sync's QR code holds a hostealo-terminal://sync link: scanned with the camera, it
       opens the app, which connects to the device showing it. -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>es.hostealo.terminal.sync</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>hostealo-terminal</string>
      </array>
    </dict>
  </array>
  <!-- iPhone and iPad: Face ID before showing a saved password or opening the locked app (Touch
       ID needs no text). English and Spanish texts in gen/apple/hostealo-terminal_iOS/*.lproj. -->
  <key>NSFaceIDUsageDescription</key>
  <string>Hostealo Terminal usa Face ID para mostrar una contraseña guardada y, si lo activas, para desbloquear la app.</string>
  <!-- Export compliance: encryption only through standard algorithms (SSH, TLS), so App Store
       Connect does not ask again for every build. -->
  <key>ITSAppUsesNonExemptEncryption</key>
  <false/>
  <!-- iPhone and iPad: the files downloaded over SFTP or FTP show up in the Files app. -->
  <key>UIFileSharingEnabled</key>
  <true/>
  <key>LSSupportsOpeningDocumentsInPlace</key>
  <true/>
</dict>
</plist>
