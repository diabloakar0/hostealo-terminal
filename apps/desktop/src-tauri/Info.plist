<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Servers on the local network, and device sync finding your other devices (Bonjour). -->
  <key>NSLocalNetworkUsageDescription</key>
  <string>Hostealo Terminal se conecta a los servidores de tu red local y busca tus otros dispositivos para sincronizar tus servidores, sin pasar por internet.</string>
  <key>NSBonjourServices</key>
  <array>
    <string>_hostealo-sync._tcp</string>
  </array>
  <!-- iPhone and iPad: Face ID before showing a saved password or opening the locked app (Touch
       ID needs no text). English and Spanish texts in gen/apple/hostealo-terminal_iOS/*.lproj. -->
  <key>NSFaceIDUsageDescription</key>
  <string>Hostealo Terminal usa Face ID para mostrar una contraseña guardada y, si lo activas, para desbloquear la app.</string>
  <!-- iPhone and iPad: the files downloaded over SFTP or FTP show up in the Files app. -->
  <key>UIFileSharingEnabled</key>
  <true/>
  <key>LSSupportsOpeningDocumentsInPlace</key>
  <true/>
</dict>
</plist>
